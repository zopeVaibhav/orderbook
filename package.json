{
    "name": "orderbook",
    "private": true,
    "scripts": {
        "setup": "bun run --filter @repo/database generate && bun run --filter @repo/database migrate:deploy && bun run --filter @repo/database seed && bun run --filter server sync-markets && bun run --filter marketmaker seed-bots",
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
        "check-types": "turbo run check-types",
        "prepare": "husky"
    },
    "devDependencies": {
        "@repo/eslint-config": "workspace:*",
        "eslint": "^10.8.1",
        "husky": "^9.1.7",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "turbo": "^2.10.9",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=20.9.0"
    },
    "packageManager": "bun@1.3.14",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "lint-staged": {
        "*.{ts,tsx,md,json}": "prettier --write"
    }
}
