{
    "name": "orderbook",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tjsx,md,json}\"",
        "check-types": "turbo run check-types",
        "prepare": "husky"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^17.0.5",
        "prettier": "^3.7.4",
        "turbo": "^2.9.14",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=18"
    },
    "packageManager": "bun@1.3.11",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "lint-staged": {
        "*.{ts,tsx,md,json}": "prettier --write"
    }
}
