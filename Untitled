GREEN="\033[0;32m"
RED="\033[0;31m"
MAGENTA="\033[1;35m"
CYAN="\033[0;36m"
RESET="\033[0m"

echo "${MAGENTA}Running pre-push checks...${RESET}"

echo "${CYAN}Running linter...${RESET}"
bun run lint || { echo "${RED}Linting failed${RESET}"; exit 1; }

echo "${CYAN}Running type checks...${RESET}"
bun run check-types || { echo "${RED}Type checking failed${RESET}"; exit 1; }

echo "${CYAN}Running build...${RESET}"
bun run build || { echo "${RED}Build failed${RESET}"; exit 1; }

echo "${CYAN}Checking Rust formatting...${RESET}"
(cd apps/engine && cargo fmt --check) || { echo "${RED}cargo fmt failed${RESET}"; exit 1; }

echo "${CYAN}Running clippy...${RESET}"
(cd apps/engine && cargo clippy -- -D warnings) || { echo "${RED}clippy failed${RESET}"; exit 1; }

echo "${GREEN}All pre-push checks passed${RESET}"
